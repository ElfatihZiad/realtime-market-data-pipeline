    max(high)                                      as high,
    min(low)                                       as low,
    argMax(close, window_start)                    as close,
    sum(volume)                                    as volume,
    sum(vwap * volume) / nullIf(sum(volume), 0)    as vwap,
    argMax(close, window_start)
        / nullIf(argMin(open, window_start), 0) - 1 as return_pct
from bars
group by instrument_id, trade_date
          )
        
