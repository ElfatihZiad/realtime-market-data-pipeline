[0m01:06:48.054018 [debug] [Thread-1 (]: dbt_clickhouse adapter: On model.mdp.stg_ticks: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "mdp", "target_name": "dev", "node_id": "model.mdp.stg_ticks"} */


  create or replace view `market_staging`.`stg_ticks` 
  
    
  
  
    
    
  as (
    -- Silver: trades, typed and with the late ones marked rather than removed.
--
-- A trade that missed its window is still a real trade. Dropping it here would
-- hide the cost of the watermark delay; keeping it unmarked would let it leak
-- into aggregates that Flink deliberately excluded. So it is kept and flagged,
-- and every downstream model chooses explicitly.
with ticks as (
    select * from `market`.`ticks`
),

late as (
    select distinct instrument_id, sequence
    from `market`.`ticks_late`
)

select
    t.instrument_id,
    t.venue,
    t.event_time,
    t.ingest_time,
    toDate(t.event_time)                      as trade_date,
    t.price,
    t.size,
    t.price * t.size                          as notional,
    t.side,
    t.sequence,
    t.latency_us,
    t.latency_us / 1000.0                     as latency_ms,
    l.sequence is not null                    as was_late
from ticks as t
left join late as l
    on t.instrument_id = l.instrument_id
   and t.sequence = l.sequence
    
  )
      
      
