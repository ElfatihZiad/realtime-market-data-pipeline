 "started_at": "2026-11-03T09:18:36.349142Z", "completed_at": "2026-11-03T09:18:36.842108Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.5019500255584717, "adapter_response": {"_message": "OK", "query_id": "12c4a001-d127-4514-867b-26ae63976d7e"}, "message": "OK", "failures": null, "unique_id": "model.mdp.fct_bars_daily", "compiled": true, "compiled_code": "-- Gold: one row per instrument per day, rolled up from the 1m bars.\n--\n-- Built from bars rather than from ticks on purpose. The bars are already\n-- watermark-closed, so this inherits that completeness instead of re-deciding\n-- what \"the end of the day\" means.\nwith bars as (\n    select *\n    from `market_staging`.`stg_bars`\n    where bar_interval = '1m'\n)\n\n-- Every column is qualified with `b.`: ClickHouse resolves a bare `volume`\n-- against the output alias `volume`, decides `sum(volume)` is nested inside\n-- another aggregate, and rejects the query.\nselect\n    b.instrument_id                                    as instrument_id,\n    b.trade_date                                       as trade_date,\n    min(b.window_start)                                as first_bar_at,\n    max(b.window_start)                                as last_bar_at,\n    count()                                            as bars,\n    sum(b.trades)                                      as trades,\n    argMin(b.open, b.window_start)                     as open,\n    max(b.high)                                        as high,\n    min(b.low)                                         as low,\n    argMax(b.close, b.window_start)                    as close,\n    sum(b.volume)                                      as volume,\n    sum(b.vwap * b.volume) / nullIf(sum(b.volume), 0)  as vwap,\n    argMax(b.close, b.window_start)\n        / nullIf(argMin(b.open, b.window_start), 0) - 1 as return_pct\nfrom bars as b\ngroup by b.instrument_id, b.trade_date", "relation_name": "`market_marts`.`fct_bars_daily`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:36.853331Z", "completed_at": "2026-11-03T09:18:36.859849Z"}, {"name": "execute", "started_at": "2026-11-03T09:18:36.862407Z", "completed_at": "2026-11-03T09:18:37.035991Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.1855161190032959, "adapter_response": {"_message": "OK", "query_id": "d9c69790-d707-4f9b-b094-c8fc2399ddc3"}, "message": "OK", "failures": null, "unique_id": "model.mdp.fct_instrument_liquidity", "compiled": true, "compiled_code": "-- Gold: how tradeable each instrument actually was, per day.\n--\n-- Uses stg_ticks including late arrivals: this is a question about the market,\n-- not about our windowing, so a trade that reached us late still happened.\nselect\n    instrument_id,\n    trade_date,\n    count()                                   as trades,\n    countIf(was_late)                         as late_trades,\n    sum(size)                                 as volume,\n    sum(notional)                             as notional,\n    avg(size)                                 as avg_trade_size,\n    quantile(0.5)(size)                       as median_trade_size,\n    quantile(0.99)(size)                      as p99_trade_size,\n    countIf(side = 'buy')                     as buy_trades,\n    countIf(side = 'sell')                    as sell_trades,\n    (countIf(side = 'buy') - countIf(side = 'sell'))\n        / nullIf(count(), 0)                  as order_flow_imbalance\nfrom `market_staging`.`stg_ticks`\ngroup by instrument_id, trade_date", "relation_name": "`market_marts`.`fct_instrument_liquidity`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:37.039949Z", "completed_at": "2026-11-03T09:18:37.043888Z"}, {"name": "execute", "started_at": "2026-11-03T09:18:37.044745Z", "completed_at": "2026-11-03T09:18:37.194843Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.15601801872253418, "adapter_response": {"_message": "OK", "query_id": "3f8e1073-caec-4727-bbb3-8944363e149a"}, "message": "OK", "failures": null, "unique_id": "model.mdp.fct_pipeline_health", "compiled": true, "compiled_code": "-- Gold: the pipeline's own report card.\n--\n-- Most portfolio projects can tell you what the data says. Rather fewer can\n-- tell you how late it was, how much of it missed its window, and how much\n-- never parsed at all. That is this table.\nwith ticks as (\n    select\n        trade_date,\n        count()                         as ticks,\n        countIf(was_late)               as late_ticks,\n        quantile(0.5)(latency_ms)       as p50_latency_ms,\n        quantile(0.95)(latency_ms)      as p95_latency_ms,\n        quantile(0.99)(latency_ms)      as p99_latency_ms,\n        max(latency_ms)                 as max_latency_ms,\n        uniqExact(instrument_id)        as instruments\n    from `market_staging`.`stg_ticks`\n    group by trade_date\n),\n\nbars as (\n    select trade_date, count() as bars\n    from `market_staging`.`stg_bars`\n    where bar_interval = '1m'\n    group by trade_date\n),\n\ndecode_errors as (\n    select toDate(occurred_at) as trade_date, count() as decode_errors\n    from `market`.`ticks_errors`\n    group by trade_date\n)\n\nselect\n    t.trade_date                                     as trade_date,\n    t.instruments                                    as instruments,\n    t.ticks                                          as ticks,\n    coalesce(b.bars, 0)                              as bars,\n    t.late_ticks                                     as late_ticks,\n    t.late_ticks / nullIf(t.ticks, 0)                as late_rate,\n    coalesce(e.decode_errors, 0)                     as decode_errors,\n    t.p50_latency_ms                                 as p50_latency_ms,\n    t.p95_latency_ms                                 as p95_latency_ms,\n    t.p99_latency_ms                                 as p99_latency_ms,\n    t.max_latency_ms                                 as max_latency_ms\nfrom ticks as t\nleft join bars as b on t.trade_date = b.trade_date\nleft join decode_errors as e on t.trade_date = e.trade_date", "relation_name": "`market_marts`.`fct_pipeline_health`", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:37.199486Z", "completed_at": "2026-11-03T09:18:37.209520Z"}, {"name": "execute", "started_at": "2026-11-03T09:18:37.209957Z", "completed_at": "2026-11-03T09:18:37.221816Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0235140323638916, "adapter_response": {"_message": "OK", "query_id": "1f8f485a-38fa-488c-9ea9-1dda859ac4ae"}, "message": null, "failures": 0, "unique_id": "test.mdp.not_null_fct_bars_daily_bars.e2494979ef", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect bars\nfrom `market_marts`.`fct_bars_daily`\nwhere bars is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:37.226510Z", "completed_at": "2026-11-03T09:18:37.236686Z"}, {"name": "execute", "started_at": "2026-11-03T09:18:37.237167Z", "completed_at": "2026-11-03T09:18:37.247126Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.02236199378967285, "adapter_response": {"_message": "OK", "query_id": "79cd752f-b809-44f0-a437-b0760348a173"}, "message": null, "failures": 0, "unique_id": "test.mdp.not_null_fct_bars_daily_instrument_id.31dfb5c44d", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect instrument_id\nfrom `market_marts`.`fct_bars_daily`\nwhere instrument_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:37.249953Z", "completed_at": "2026-11-03T09:18:37.258227Z"}, {"name": "execute", "star