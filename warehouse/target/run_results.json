 "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:35.456237Z", "completed_at": "2026-11-03T09:18:35.460192Z"}, {"name": "execute", "started_at": "2026-11-03T09:18:35.464633Z", "completed_at": "2026-11-03T09:18:35.513489Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.058667898178100586, "adapter_response": {"_message": "OK", "query_id": "0f43c283-cc77-4673-aa4d-f4d4f6ad91c1"}, "message": "OK", "failures": null, "unique_id": "model.mdp.stg_bars", "compiled": true, "compiled_code": "-- Silver: Flink's event-time bars, deduplicated.\n--\n-- market.bars is a ReplacingMergeTree, so a re-delivered bar may exist twice\n-- until a background merge collapses it. FINAL forces that at read time \u2014 the\n-- grain below is relied on by the marts and by the uniqueness test.\nselect\n    instrument_id,\n    bar_interval,\n    window_start,\n    window_end,\n    toDate(window_start) as trade_date,\n    open,\n    high,\n    low,\n    close,\n    volume,\n    vwap,\n    trades\nfrom `market`.`bars` final", "relation_name": "`market_staging`.`stg_bars`", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:35.520421Z", "completed_at": "2026-11-03T09:18:35.524699Z"}, {"name": "execute", "started_at": "2026-11-03T09:18:35.525247Z", "completed_at": "2026-11-03T09:18:35.572111Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0534358024597168, "adapter_response": {"_message": "OK", "query_id": "01f0d0ba-5055-4f46-a7d5-682ebb5f1373"}, "message": "OK", "failures": null, "unique_id": "model.mdp.stg_ticks", "compiled": true, "compiled_code": "-- Silver: trades, typed and with the late ones marked rather than removed.\n--\n-- A trade that missed its window is still a real trade. Dropping it here would\n-- hide the cost of the watermark delay; keeping it unmarked would let it leak\n-- into aggregates that Flink deliberately excluded. So it is kept and flagged,\n-- and every downstream model chooses explicitly.\n--\n-- was_late is a tuple IN, not a LEFT JOIN. ClickHouse does not produce NULLs\n-- for unmatched left-join rows unless join_use_nulls is set: it fills the\n-- column's default, which for String is ''. So `l.sequence is not null` was\n-- true for EVERY row and the first build of fct_pipeline_health reported a\n-- late rate of exactly 1.0 across every day.\nwith ticks as (\n    select * from `market`.`ticks`\n)\n\nselect\n    t.instrument_id,\n    t.venue,\n    t.event_time,\n    t.ingest_time,\n    toDate(t.event_time)                      as trade_date,\n    t.price,\n    t.size,\n    t.price * t.size                          as notional,\n    t.side,\n    t.sequence,\n    t.latency_us,\n    t.latency_us / 1000.0                     as latency_ms,\n    (t.instrument_id, t.sequence) in (\n        select instrument_id, sequence\n        from `market`.`ticks_late`\n    )                                         as was_late\nfrom ticks as t", "relation_name": "`market_staging`.`stg_ticks`", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:35.576848Z", "completed_at": "2026-11-03T09:18:35.588789Z"}, {"name": "execute", "started_at": "2026-11-03T09:18:35.589204Z", "completed_at": "2026-11-03T09:18:35.618483Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04362797737121582, "adapter_response": {"_message": "OK", "query_id": "6d1f0859-a0da-4622-985b-c96bbe76ad84"}, "message": null, "failures": 0, "unique_id": "test.mdp.accepted_values_stg_bars_bar_interval__1m__5m.a47cabc2ff", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        bar_interval as value_field,\n        count(*) as n_records\n\n    from `market_staging`.`stg_bars`\n    group by bar_interval\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    '1m','5m'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:35.622086Z", "completed_at": "2026-11-03T09:18:35.625420Z"}, {"name": "execute", "started_at": "2026-11-03T09:18:35.625874Z", "completed_at": "2026-11-03T09:18:35.647859Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.026652812957763672, "adapter_response": {"_message": "OK", "query_id": "a25095c9-6d72-41e9-8c7e-d92639f12c03"}, "message": null, "failures": 0, "unique_id": "test.mdp.assert_bar_grain_is_unique", "compiled": true, "compiled_code": "-- A bar is identified by (instrument, interval, window start). Two rows at\n-- that grain means the dedup in stg_bars failed, or two Flink jobs were\n-- writing the same topic \u2014 which is exactly what happened once during\n-- development when a job was submitted twice.\nselect\n    instrument_id,\n    bar_interval,\n    window_start,\n    count() as n\nfrom `market_staging`.`stg_bars`\ngroup by instrument_id, bar_interval, window_start\nhaving n > 1", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:35.650943Z", "completed_at": "2026-11-03T09:18:35.653891Z"}, {"name": "execute", "started_at": "2026-11-03T09:18:35.654297Z", "completed_at": "2026-11-03T09:18:35.673289Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.02325129508972168, "adapter_response": {"_message": "OK", "query_id": "5a57b9c4-8488-404e-bffc-62635b1f85a5"}, "message": null, "failures": 0, "unique_id": "test.mdp.assert_ohlc_is_internally_consistent", "compiled": true, "compiled_code": "-- high must be the highest and low the lowest, and open/close must sit\n-- between them. If windowing or the open/close ordering invariant breaks,\n-- this is where it shows up.\nselect\n    instrument_id,\n    bar_interval,\n    window_start,\n    open, high, low, close\nfrom `market_staging`.`stg_bars`\nwhere high < low\n   or open > high or open < low\n   or close > high or close < low", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:35.677518Z", "completed_at": "2026-11-03T09:18:35.680939Z"}, {"name": "execute", "started_at": "2026-11-03T09:18:35.681291Z", "completed_at": "2026-11-03T09:18:35.700197Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.024007081985473633, "adapter_response": {"_message": "OK", "query_id": "f94122e7-a301-4914-8f08-20d5db66f9f2"}, "message": null, "failures": 0, "unique_id": "test.mdp.assert_vwap_within_bar_range", "compiled": true, "compiled_code": "-- A volume-weighted average price cannot fall outside the bar's own range.\n-- A tiny tolerance absorbs float rounding; see ADR 0007 on price as double.\nselect\n    instrument_id,\n    bar_interval,\n    window_start,\n    low, vwap, high\nfrom `market_staging`.`stg_bars`\nwhere volume > 0\n  and (vwap < low - 1e-6 or vwap > high + 1e-6)", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:35.703784Z", "completed_at": "2026-11-03T09:18:35.713010Z"}, {"name": "execute", "started_at": "2026-11-03T09:18:35.713567Z", "completed_at": "2026-11-03T09:18:35.725720Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.023312807083129883, "adapter_response": {"_message": "OK", "query_id": "1d7f447b-46d1-47b9-92b5-53dc4e651b3a"}, "message": null, "failures": 0, "unique_id": "test.mdp.not_null_stg_bars_bar_interval.6e425871ee", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect bar_interval\nfrom `market_staging`.`stg_bars`\nwhere bar_interval is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-03T09:18:35.730754Z", "completed_at": "2026-11-03T09:18:35.741797Z"}, {"name": "execute", "started_at": "2026-11-03T0