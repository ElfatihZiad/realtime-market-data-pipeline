# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Kafka ---
KAFKA_BOOTSTRAP=localhost:19092
TICKS_TOPIC=ticks.raw
TICKS_DLQ_TOPIC=ticks.dlq

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=market
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Feeds (Phase 1 uses only the public, keyless crypto feed) ---
# Comma-separated Coinbase product ids
CRYPTO_SYMBOLS=BTC-USD,ETH-USD,SOL-USD
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# --- News and sentiment ---
# vader (default, keyless) or claude (needs ANTHROPIC_API_KEY and the extra:
# uv sync --extra claude)
SENTIMENT_SCORER=vader
NEWS_POLL_SECONDS=300
# ANTHROPIC_API_KEY=

# --- Batch sources ---
# SEC requires a descriptive User-Agent with real contact details.
SEC_USER_AGENT=market-data-pipeline (you@example.com)
EDGAR_TICKERS=AAPL,MSFT,GOOGL,AMZN,TSLA,META
# Free key from https://fredaccount.stlouisfed.org/apikeys
# Without it the macro loader skips cleanly instead of failing.
# FRED_API_KEY=

# --- Later phases ---
# FINNHUB_API_KEY=
# NEWSAPI_KEY=

# --- Observability ---
# Traces are opt-in. Unset this and the services run exactly as before, with
# no collector required.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
